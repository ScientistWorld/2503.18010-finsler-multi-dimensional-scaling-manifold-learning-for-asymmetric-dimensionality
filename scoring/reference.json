{
    "experiments": {
        "directed_tree_reconstruction": {
            "description": "Directed binary-tree hierarchy reconstruction from Figure 5. The paper reports this result qualitatively: symmetric baselines do not reveal hierarchy direction and distort distances, while Finsler MDS reveals the hierarchy direction and highly preserves distances.",
            "weight": 0.5,
            "primary_metric": "distance_preservation_pass",
            "metrics": {
                "distance_preservation_pass": {
                    "higher_is_better": true,
                    "coefficient": 1.0
                },
                "asymmetry_preservation_pass": {
                    "higher_is_better": true,
                    "coefficient": 1.0
                },
                "hierarchy_direction_pass": {
                    "higher_is_better": true,
                    "coefficient": 0.7
                }
            },
            "results": {
                "euclidean_mds": {
                    "type": "baseline",
                    "distance_preservation_pass": 0,
                    "asymmetry_preservation_pass": 0,
                    "hierarchy_direction_pass": 0
                },
                "finsler_mds": {
                    "type": "proposed",
                    "distance_preservation_pass": 1,
                    "asymmetry_preservation_pass": 1,
                    "hierarchy_direction_pass": 1
                }
            }
        },
        "directed_tree_depth5_reconstruction": {
            "description": "Additional directed binary-tree hierarchy reconstruction setting matching Figure 5's various-depth tree setup. Qualitative reference expectations are the same: Finsler MDS should preserve asymmetric distances and reveal hierarchy direction, unlike the symmetric Euclidean embedding.",
            "weight": 0.25,
            "primary_metric": "distance_preservation_pass",
            "metrics": {
                "distance_preservation_pass": {
                    "higher_is_better": true,
                    "coefficient": 1.0
                },
                "asymmetry_preservation_pass": {
                    "higher_is_better": true,
                    "coefficient": 1.0
                },
                "hierarchy_direction_pass": {
                    "higher_is_better": true,
                    "coefficient": 0.7
                }
            },
            "results": {
                "euclidean_mds": {
                    "type": "baseline",
                    "distance_preservation_pass": 0,
                    "asymmetry_preservation_pass": 0,
                    "hierarchy_direction_pass": 0
                },
                "finsler_mds": {
                    "type": "proposed",
                    "distance_preservation_pass": 1,
                    "asymmetry_preservation_pass": 1,
                    "hierarchy_direction_pass": 1
                }
            }
        },
        "cora_2d_asymmetric_distance_reconstruction": {
            "description": "Cora directed-graph asymmetric distance reconstruction, 2D embeddings, Table 1.",
            "weight": 0.25,
            "primary_metric": "normalized_stress",
            "metrics": {
                "normalized_stress": {
                    "higher_is_better": false,
                    "coefficient": -1.0
                },
                "map_at_10": {
                    "higher_is_better": true,
                    "coefficient": 0.6
                }
            },
            "results": {
                "euclidean_embedding": {
                    "type": "baseline",
                    "normalized_stress": 0.426,
                    "map_at_10": 0.574
                },
                "finsler_embedding": {
                    "type": "proposed",
                    "normalized_stress": 0.127,
                    "map_at_10": 0.894
                }
            }
        }
    }
